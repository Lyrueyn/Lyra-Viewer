<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIGui.ExtensionTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIGui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock x:Name="TitleText" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Foreground="#9BA0A5" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="OpenFileBtn" Click="OpenFile_Click" Background="#FB7299" BorderThickness="0"
                    Foreground="#FFFFFF" CornerRadius="14" Padding="12,5"/>
            <Button x:Name="AddFileBtn" Click="AddFile_Click" Background="#33FFFFFF" BorderThickness="0"
                    Foreground="#FFFFFF" CornerRadius="14" Padding="12,5"/>
            <Button x:Name="NewFileBtn" Click="NewFile_Click" Background="#33FFFFFF" BorderThickness="0"
                    Foreground="#FFFFFF" CornerRadius="14" Padding="12,5" Visibility="Collapsed"/>
            <ToggleButton x:Name="ManageToggle" Content="管理" IsChecked="False" Click="ManageToggle_Click"
                          Background="#33FFFFFF" BorderThickness="0" Foreground="#FFFFFF"
                          CornerRadius="14" Padding="12,5" ToolTipService.ToolTip="显示/隐藏卡片上的封面、删除按钮"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="#9BA0A5" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <GridView x:Name="LibraryGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="LibraryGrid_ItemClick" RightTapped="LibraryGrid_RightTapped" Padding="0,0,0,16">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="170" Spacing="6" Margin="0,0,14,16">
                        <Border Width="170" Height="210" CornerRadius="8" Background="#1E1E1E"
                                BorderBrush="#2A2A2A" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="📄" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <Button Content="封面" Tag="{Binding Id}" Click="CoverBtn_Click"
                                        Visibility="{Binding CoverButtonVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="6" Padding="6,2" FontSize="10" MinHeight="24" Background="#B3000000"
                                        Foreground="White" BorderThickness="0" CornerRadius="10"/>
                                <Button Content="删除" Tag="{Binding Id}" Click="DeleteBtn_Click"
                                        Visibility="{Binding CoverButtonVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,6,60,0" Padding="6,2" FontSize="10" MinHeight="24" Background="#B3B00020"
                                        Foreground="White" BorderThickness="0" CornerRadius="10"/>
                                <TextBlock Text="{Binding DateText}" Foreground="#9BA0A5" FontSize="10"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Author}" Foreground="#9BA0A5" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>